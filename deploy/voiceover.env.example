# /etc/voiceover.env — read by the voiceover systemd service. Keep it private (chmod 600).
# Public address of the studio, without https://.
VOICEOVER_DOMAIN=voices.example.com
VOICEOVER_ALLOWED_HOSTS=voices.example.com
VOICEOVER_SECURE_COOKIES=1
VOICEOVER_DATA_DIR=/var/lib/voiceover

# Rendering on the Runpod Serverless GPU endpoint (worker/README.md). Chatterbox is off on this CPU server.
VOICEOVER_DEVICE=off
VOICEOVER_DIRECTED_DEVICE=remote
VOICEOVER_RUNPOD_ENDPOINT=
VOICEOVER_RUNPOD_API_KEY=
# Shared secret the GPU worker uses to download trained voices. Generate with: openssl rand -hex 32
VOICEOVER_WORKER_TOKEN=

# Automatic checks run on this server's CPU (models downloaded by setup.sh).
VOICEOVER_ASR_DIR=/opt/voiceover/models/whisper-small.en
# The inbox folder is a desktop feature; switch it off on the server.
VOICEOVER_INBOX=off
HF_HUB_OFFLINE=1
